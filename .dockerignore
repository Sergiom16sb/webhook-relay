# Files not needed in Docker build context.
# Speeds up build and keeps image small.

# VCS
.git
.gitignore
.gitattributes

# CI/CD
.github

# Documentation (not needed at runtime)
*.md
LICENSE

# Local config
.env
.env.*
!.env.example

# IDE
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Go build artifacts (built fresh in container)
api
api.exe
*.test
*.out

